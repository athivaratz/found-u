!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
students-test.csv

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env
.env.setup.local

# Firebase Service Account Keys (NEVER commit these!)
*-firebase-adminsdk-*.json
firebase-admin*.json
service-account*.json
*.pem

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# development
docs/*
!docs/php-port/
!docs/php-port/**

