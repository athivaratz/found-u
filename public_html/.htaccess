# Origin lock and front controller. Cloudflare IP list lives between the
# foundu-cloudflare-ips markers. bin/cron.php refreshes that block and
# foundu/config/cloudflare-ips.php together. Do not add another Require ip
# outside the markers, or the check will refuse the new list.
# Local docker turns the lock off by creating .cf-allowlist-off
# (FOUNDU_CF_ALLOWLIST=off). Do not upload that file.
# Assumes REMOTE_ADDR is still the TCP peer. If the host restores the
# visitor IP into REMOTE_ADDR, this Require ip block will reject everyone
# and the check has to move into PHP.

Options -Indexes -MultiViews

LimitRequestBody 262144

<IfModule php_module>
    php_flag session.upload_progress.enabled Off
    php_flag session.upload_progress.cleanup Off
</IfModule>
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled Off
    php_flag session.upload_progress.cleanup Off
</IfModule>
<IfModule mod_php8.c>
    php_flag session.upload_progress.enabled Off
    php_flag session.upload_progress.cleanup Off
</IfModule>

<IfModule mod_headers.c>
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self)"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com https://*.tile.openstreetmap.org; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:"
    Header always unset X-Powered-By
</IfModule>

<If "-f %{DOCUMENT_ROOT}.'/.cf-allowlist-off'">
    Require all granted
</If>
<ElseIf "%{REQUEST_URI} =~ m#^/\.well-known/acme-challenge(/|$)#">
    Require all granted
</ElseIf>
<Else>
    # BEGIN foundu-cloudflare-ips
    Require ip 173.245.48.0/20
    Require ip 103.21.244.0/22
    Require ip 103.22.200.0/22
    Require ip 103.31.4.0/22
    Require ip 141.101.64.0/18
    Require ip 108.162.192.0/18
    Require ip 190.93.240.0/20
    Require ip 188.114.96.0/20
    Require ip 197.234.240.0/22
    Require ip 198.41.128.0/17
    Require ip 162.158.0.0/15
    Require ip 104.16.0.0/13
    Require ip 104.24.0.0/14
    Require ip 172.64.0.0/13
    Require ip 131.0.72.0/22
    Require ip 2400:cb00::/32
    Require ip 2606:4700::/32
    Require ip 2803:f800::/32
    Require ip 2405:b500::/32
    Require ip 2405:8100::/32
    Require ip 2a06:98c0::/29
    Require ip 2c0f:f248::/32
    # END foundu-cloudflare-ips
</Else>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "~$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^list/?$ /home/ [R=301,L,QSA]
    RewriteRule ^login/register/?$ /auth/register/ [R=301,L,QSA]
    RewriteRule ^login/forgot-pin/?$ /auth/login/forgot-pin/ [R=301,L,QSA]
    RewriteRule ^login/reset-password/?$ /auth/login/reset-password/ [R=301,L,QSA]
    RewriteRule ^login/change-password/?$ /auth/change-password/ [R=301,L,QSA]
    RewriteRule ^login/setup-pin/?$ /auth/setup-pin/ [R=301,L,QSA]
    RewriteRule ^login/?$ /auth/login/ [R=301,L,QSA]

    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\. - [F,L]

    RewriteCond %{REQUEST_URI} \.(?:php|phtml|phar|phps)$ [NC]
    RewriteCond %{REQUEST_URI} !^/api/index\.php$ [NC]
    RewriteRule ^ - [F,L]

    RewriteRule ^(?:uploads|files|storage)/ - [F,L]

    RewriteRule ^api(?:/.*)?$ api/index.php [END,QSA]

    RewriteRule ^admin/blog/legacy/([^/]+)/?$ /admin/blog/legacy/_/index.html [END]
    RewriteRule ^admin/blog/([^/]+)/?$ /admin/blog/_/index.html [END]
    RewriteRule ^admin/help/([^/]+)/?$ /admin/help/_/index.html [END]

    # Blog and help HTML go through meta.php so the exported shell gets a
    # real title, description, canonical, and Open Graph tags. The shell
    # files are public_html/blog/_/index.html and help/_/index.html.
    # P11 must keep these rules, and must not let a later catch-all
    # serve those paths as plain index.html. See docs/php-port/cms.md.
    RewriteRule ^blog/([^/]+)/opengraph-image/?$ og.php?kind=blog&slug=$1 [END,QSA]
    RewriteRule ^help/([^/]+)/opengraph-image/?$ og.php?kind=help&slug=$1 [END,QSA]
    RewriteRule ^og/(blog|help)/([^/]+)\.png$ og.php?kind=$1&slug=$2 [END,QSA]
    RewriteRule ^blog/([^/]+)/?$ meta.php?kind=blog&slug=$1 [END,QSA]
    RewriteRule ^help/([^/]+)/?$ meta.php?kind=help&slug=$1 [END,QSA]

    RewriteRule ^nfc/t/([^/]+)/?$ /nfc/t/_/index.html [END]
</IfModule>
