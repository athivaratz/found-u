# The browser and the PHP API share one origin. Apache serves the
# static export and rewrites /api to public_html/api/index.php.
# APP_URL in foundu/config/.env.php is that origin.

NEXT_PUBLIC_APP_URL=http://localhost:8080
SCHOOL_AUTH_DOMAIN=school.test

# Optional. PHP reads the keys from .env.php or the encrypted row.
GEMINI_API_KEY=
GEMMA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SEARCH_USE_TRGM=true
SEARCH_SIMILARITY_THRESHOLD=0.15
AGENT_SEARCH_SIMILARITY_THRESHOLD=0.30
