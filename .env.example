# Found-U Environment Variables
# See README "Deploy ให้โรงเรียนใหม่" for Vercel + Supabase, then manual db:push

# ═══════════════════════════════════════════════════════════════════
# REQUIRED — auto-injected by Vercel + Supabase integration
# ═══════════════════════════════════════════════════════════════════

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# App identity (set SCHOOL_AUTH_DOMAIN once the school domain is known)
# NEXT_PUBLIC_APP_URL falls back to VERCEL_URL when unset
NEXT_PUBLIC_APP_URL=https://your-school.example.com
SCHOOL_AUTH_DOMAIN=your-school.ac.th

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — AI (admin settings, or these env fallbacks)
# ═══════════════════════════════════════════════════════════════════

GEMMA_API_KEY=YOUR_GEMMA_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Encrypts AI keys stored in system_config. Required in production if you
# do not want the service role key used as the encryption material.
# SETUP_SECRETS_KEY=

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — Storage (R2 for existing production; otherwise Supabase Storage)
# ═══════════════════════════════════════════════════════════════════

R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_PUBLIC_BASE_URL=YOUR_R2_PUBLIC_BASE_URL

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — Rate limiting & search tuning
# ═══════════════════════════════════════════════════════════════════

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SEARCH_USE_TRGM=true
SEARCH_SIMILARITY_THRESHOLD=0.15
AGENT_SEARCH_SIMILARITY_THRESHOLD=0.30
