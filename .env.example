# Next.js local env. The API is PHP. Set FOUNDU_API_ORIGIN so `next dev`
# proxies /api at the docker web container.

FOUNDU_API_ORIGIN=http://127.0.0.1:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
SCHOOL_AUTH_DOMAIN=school.test

# Optional AI keys. Keys stored in the database are read by PHP.
GEMINI_API_KEY=
GEMMA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional object storage. Uploads move to PHP in a later phase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SEARCH_USE_TRGM=true
SEARCH_SIMILARITY_THRESHOLD=0.15
AGENT_SEARCH_SIMILARITY_THRESHOLD=0.30
