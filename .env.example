# Found-U Environment Variables
# See README "Deploy โรงเรียนใหม่" for 1-click Vercel + Supabase setup

# ═══════════════════════════════════════════════════════════════════
# REQUIRED — auto-injected by Vercel + Supabase integration
# ═══════════════════════════════════════════════════════════════════

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Direct Postgres (first-boot schema hydration — Module 2)
# Vercel + Supabase: auto-synced. Local: Dashboard → Database or `vercel env pull`
# Alternative local: `bun run db:push` if schema is already complete
POSTGRES_URL_NON_POOLING=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# App identity (optional on first deploy — Vercel injects VERCEL_URL; set after you know your *.vercel.app URL)
NEXT_PUBLIC_APP_URL=https://your-school.example.com
SCHOOL_AUTH_DOMAIN=your-school.ac.th

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — AI (Setup Wizard Step 2 or manual env; Module 5 reads DB first)
# ═══════════════════════════════════════════════════════════════════

GEMMA_API_KEY=YOUR_GEMMA_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional encryption key override for wizard-stored AI keys (defaults to service role key)
# SETUP_SECRETS_KEY=

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — Storage (R2 for existing production; new deploys use Supabase Storage)
# ═══════════════════════════════════════════════════════════════════

R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_PUBLIC_BASE_URL=YOUR_R2_PUBLIC_BASE_URL

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — Rate limiting & search tuning
# ═══════════════════════════════════════════════════════════════════

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SEARCH_USE_TRGM=true
SEARCH_SIMILARITY_THRESHOLD=0.15
AGENT_SEARCH_SIMILARITY_THRESHOLD=0.30

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL — Discord verification bot
# The Next.js site uses DISCORD_* role settings; the bot process also needs
# FOUNDU_BASE_URL, DISCORD_BOT_TOKEN, DISCORD_APPLICATION_ID and the same API secret.
# ═══════════════════════════════════════════════════════════════════

# Discord Developer Portal → Bot → Token (bot process only; never expose to browser)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Discord Developer Portal → General Information → Application ID
DISCORD_APPLICATION_ID=YOUR_DISCORD_APPLICATION_ID
# Discord server ID (enable Developer Mode in Discord, then Copy Server ID)
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID

# A random secret of 32+ characters shared only by the website and bot.
# Example generation: openssl rand -hex 32
DISCORD_BOT_API_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional separate pepper for one-time verification links. If omitted, the API secret is used.
DISCORD_VERIFICATION_TOKEN_SECRET=

# At least one of the Role settings below is required.
DISCORD_VERIFIED_ROLE_ID=YOUR_VERIFIED_ROLE_ID
DISCORD_ADMIN_ROLE_ID=YOUR_ADMIN_ROLE_ID
# Optional grade/room rules. Each matching rule adds its Discord Role.
# DISCORD_ROLE_RULES_JSON=[{"roleId":"123456789012345678","when":{"gradeLevel":"ม.6","roomNumber":"1"}}]

# Bot process only: public base URL of this deployed Found-U site (no trailing slash)
FOUNDU_BASE_URL=https://your-school.example.com
# Optional: 5,000–60,000 ms; defaults to 8,000.
DISCORD_SYNC_INTERVAL_MS=8000
